{
  "name": "toolzzz",
  "version": "3.9.1",
  "private": true,
  "description": "Extension pour www.fourmizzz.fr.",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test:vendor": "wxt build && node scripts/test-vendor.mjs",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "postinstall": "wxt prepare",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/datatables.net": "^1.12.3",
    "@types/jquery": "3.5.34",
    "@types/jqueryui": "^1.12.24",
    "@types/numeral": "^2.0.5",
    "husky": "^9.1.7",
    "jsdom": "^30.1.0",
    "lint-staged": "^17.0.0",
    "oxfmt": "^0.55.0",
    "typescript": "^6.0.0",
    "vite": "^8.3.0",
    "web-ext": "^10.6.0",
    "wxt": "^0.21.4"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx,jsx,css,scss,less,html,json,jsonc,md,mdx,yml,yaml}": "oxfmt --no-error-on-unmatched-pattern"
  }
}
